// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`


generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum TenantStatus{
  PENDING
  APPROVED
  REJECTED
}


//Şirketlerin başvuru durumu
enum TenantApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}


//Platforma kabul edilen şirketin kaydı, Hangi şirket
model Tenant {
  id             String       @id @default(cuid())   //her kiracı için benzersiz id
  name           String
  slug           String       @unique
  status         TenantStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  application TenantApplication?

  memberships CompanyMembership[]
}



//Şirketlerin başvuru yapmak için gönderdiği başvurular
model TenantApplication{
  id            String                  @id @default(cuid())
  companyName   String
  slug          String
  contactName   String
  contactEmail  String
  contactPhone  String
  status        TenantApplicationStatus @default(PENDING)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  
  rejectionReason String?     //başvuru neden reddedildi
  approvedAt      DateTime?   //başvuru ne zaamn onaylandı

  tenantId      String?                 @unique
  tenant        Tenant?                 @relation(fields: [tenantId], references: [id])
}



//Rentacar platform yöneticileri
model PlatformAdmin{
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

//passwordHash: kullanıcının şifresinin güvenli bir algoritmayladönüştürülmüş halidir



//Şirketteki roller
enum CompanyRole{
  OWNER      //şirketin kendi yöneticisi
  EMPLOYEE   //şirket çalışanı
}



//Kullanıcı modeli, kullanıcı kim 
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  membership CompanyMembership?
}



//Kullanıcı hangi şirkette çalışıyor, o şirkette hangi yetkiye sahip 
model CompanyMembership {
  id        String      @id @default(cuid())
  userId    String      @unique
  tenantId  String
  role      CompanyRole @default(EMPLOYEE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])     //relation prismaya tabloların birbiriyle nasıl ilişkili olduğunu söyler

  @@index([tenantId])
}
